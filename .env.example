APP_NAME="GitVerse MCP Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://mcp.example.com
APP_SERVICE=app

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=gitverse_mcp
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Каждый пользователь вводит свой PAT GitVerse на странице подключения.
# Не храните токены в репозитории и не задавайте общий PAT для всех пользователей.
GITVERSE_MCP_URL=https://mcp.gitverse.ru
# Разрешённые значения заголовка Origin через запятую. Небраузерные клиенты обычно не передают Origin.
MCP_ALLOWED_ORIGINS=
# Временная диагностика MCP initialize на уровне warning без токенов и исходных данных.
MCP_INITIALIZE_DIAGNOSTICS=false

# После установки зависимостей Composer выполните php artisan passport:keys.
# Никогда не сохраняйте ключи OAuth в Git.
